# Database Configuration
DATABASE_URL=postgresql://pokemon:pokemon123@localhost:5432/poketactix?sslmode=disable
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT=300
DB_MAX_LIFETIME=1800

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
POKEMON_CACHE_TTL=720h

# JWT Configuration
JWT_SECRET=your-secret-key-min-256-bits-change-this-in-production
JWT_EXPIRATION=24h

# Server Configuration
PORT=3000
ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# External APIs
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT=10s

# Token System Configuration
TOKEN_RESET_TIME=00:00
DAILY_TOKEN_LIMIT=10
TOKEN_PRICE=100
DAILY_PURCHASE_LIMIT=10
TOKEN_COST_1V1=1
TOKEN_COST_5V5=2

# Frontend (for .env in frontend directory)
# VITE_API_URL=http://localhost:3000
